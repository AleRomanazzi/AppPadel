generator client {
  provider      = "prisma-client-js"
  // "native" = tu máquina local (macOS). Railway / muchos Docker usan Debian + OpenSSL 3.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Migraciones: usar conexión directa de Neon (sin "-pooler"), no el pooler.
  directUrl = env("DIRECT_URL")
}

enum Division {
  MEN
  WOMEN
}

model Player {
  id             Int                 @id @default(autoincrement())
  nickname       String
  division       Division            @default(MEN)
  active         Boolean             @default(true)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  pointsEntries  RankingPointEntry[]
  registrations  DateRegistration[]
  blacklistEntry BlacklistedPlayer?

  @@unique([division, nickname])
}

model BlacklistedPlayer {
  id        Int      @id @default(autoincrement())
  playerId  Int      @unique
  createdAt DateTime @default(now())
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
}

model PartnerHistory {
  id        Int      @id @default(autoincrement())
  division  Division
  playerAId Int
  playerBId Int
  dateId    Int?
  createdAt DateTime @default(now())

  @@unique([division, playerAId, playerBId])
}

model TournamentEvent {
  id        Int              @id @default(autoincrement())
  name      String
  eventDate DateTime
  createdAt DateTime         @default(now())
  dates     TournamentDate[]
}

model TournamentDate {
  id             Int                @id @default(autoincrement())
  eventId        Int
  division       Division
  status         DateStatus         @default(DRAFT)
  closedAt       DateTime?
  createdAt      DateTime           @default(now())
  event          TournamentEvent    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registrations  DateRegistration[]
  draws          DateDraw[]
  zones          Zone[]
  matches        ZoneMatch[]
  seeds          DateSeed[]
  bracketMatches BracketMatch[]

  @@unique([eventId, division])
}

model DateRegistration {
  id       Int @id @default(autoincrement())
  dateId   Int
  playerId Int

  date   TournamentDate @relation(fields: [dateId], references: [id], onDelete: Cascade)
  player Player         @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([dateId, playerId])
}

model DateDraw {
  id        Int        @id @default(autoincrement())
  dateId    Int
  status    DrawStatus @default(DRAFT)
  createdAt DateTime   @default(now())
  date      TournamentDate @relation(fields: [dateId], references: [id], onDelete: Cascade)
  pairs     DrawPair[]
}

model DrawPair {
  id      Int @id @default(autoincrement())
  drawId  Int
  player1 Int
  player2 Int
  draw    DateDraw @relation(fields: [drawId], references: [id], onDelete: Cascade)
}

model DateSeed {
  id       Int @id @default(autoincrement())
  dateId   Int
  playerId Int
  /// 1 = mejor cabeza (#1 ranking / primera del sorteo random).
  rank     Int @default(1)

  date TournamentDate @relation(fields: [dateId], references: [id], onDelete: Cascade)

  @@unique([dateId, playerId])
  @@index([dateId, rank])
}

model Zone {
  id     Int @id @default(autoincrement())
  dateId Int
  name   String
  size   Int
  date   TournamentDate @relation(fields: [dateId], references: [id], onDelete: Cascade)
}

model ZoneMatch {
  id            Int @id @default(autoincrement())
  dateId        Int
  zoneName      String
  pairAPlayer1  Int
  pairAPlayer2  Int
  pairBPlayer1  Int
  pairBPlayer2  Int
  score         String?
  winnerPairKey String?
  date          TournamentDate @relation(fields: [dateId], references: [id], onDelete: Cascade)
}

model RankingPointEntry {
  id        Int      @id @default(autoincrement())
  playerId  Int
  dateId    Int?
  points    Int
  reason    String
  manual    Boolean  @default(false)
  createdAt DateTime @default(now())
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
}

model BracketMatch {
  id            Int      @id @default(autoincrement())
  dateId        Int
  round         Int
  position      Int
  pairAPlayer1  Int?
  pairAPlayer2  Int?
  pairBPlayer1  Int?
  pairBPlayer2  Int?
  score         String?
  winnerPairKey String?
  createdAt     DateTime @default(now())
  date          TournamentDate @relation(fields: [dateId], references: [id], onDelete: Cascade)

  @@unique([dateId, round, position])
}

enum DateStatus {
  DRAFT
  OPEN
  CLOSED
}

enum DrawStatus {
  DRAFT
  CONFIRMED
}
