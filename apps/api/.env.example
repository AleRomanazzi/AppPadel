# Pooled (runtime de la API en Render). Host con "-pooler" en Neon.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/DB?sslmode=require"

# Direct (solo migraciones Prisma). Mismo user/pass/db, host SIN "-pooler".
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/DB?sslmode=require"

PORT=4000

# Producción: dominios del front permitidos (separados por coma).
# Ejemplo Vercel: CORS_ORIGIN="https://apppadel.vercel.app,https://apppadel-git-main-user.vercel.app"
CORS_ORIGIN=""
