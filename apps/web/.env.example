# Desarrollo local
VITE_API_URL="http://localhost:4000"

# Vercel (producción del front):
# 1) En Vercel: New Project → este repo
# 2) Root Directory: apps/web
# 3) Framework Preset: Vite (usa apps/web/vercel.json)
# 4) Environment Variable (Production/Preview):
#    VITE_API_URL = https://TU-API-PUBLICA.up.railway.app
#    (sin barra final)
# 5) Redeploy después de cambiar VITE_API_URL
#
# La API (Express + Prisma + Neon) conviene hostearla aparte (Railway/Render).
# En la API podés setear CORS_ORIGIN=https://tu-app.vercel.app
