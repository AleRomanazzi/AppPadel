# Desarrollo: Vite lee esto al levantar `npm run dev`.
VITE_API_URL="http://localhost:4000"

# En Railway (producción): puede bastar con VITE_API_URL o API_URL en variables del servicio web;
# el script `npm start` escribe dist/runtime-config.js al arrancar para que el front use esa URL
# aunque no estuviera disponible durante `vite build`.
